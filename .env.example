# Database (Neon PostgreSQL)
# For remote Neon: postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgres://postgres:postgres@localhost:5432/art_gallery"

# Better Auth
BETTER_AUTH_SECRET="f94a6b2c8e1d5a7304b791e3d08f2a64c81b9e57203a61f4d92b8e5c1a704e6b"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Media Infrastructure Layer (ImageKit + Cloudflare R2 Coexistence)
# Active provider for new uploads: 'imagekit' | 'cloudflare'
MEDIA_PROVIDER="imagekit"
IMAGEKIT_STORAGE=true
CLOUDFLARE_STORAGE=true

# ImageKit Configuration (Leave blank to use mock/local fallback in development)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/latelier"

# Cloudflare R2 Storage (Optional: when omitted, local mock storage is used automatically)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKET_NAME=""
CLOUDFLARE_PUBLIC_URL=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Resend Email (Optional: when omitted, emails log to server console)
RESEND_API_KEY=""
ADMIN_EMAIL="curator@latelier-lumineux.art"
EMAIL_FROM="Elena Vance Studio <curator@latelier-lumineux.art>"

# Upstash QStash (Asynchronous Queue & Scheduler)
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
QSTASH_WEBHOOK_URL="" # Optional explicit webhook override (e.g. https://your-domain.vercel.app/api/webhooks/qstash/email)
EMAIL_DELIVERY_MODE="qstash" # 'qstash' (production queue) | 'direct' (local testing)



